            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5 mb-6">
                <div id="progress-bar" class="progress-bar-fill" style="width: 0%"></div>
            </div>
            
            <h2 id="question-text" class="text-2xl font-semibold mb-6 min-h-[6rem]"></h2>
            
            <div id="answer-options" class="space-y-4">
                <!-- Options will be injected here -->
            </div>
            
            <div id="feedback" class="mt-6 text-center font-semibold"></div>
            <button id="next-btn" class="w-full mt-4 bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 px-6 rounded-lg btn hidden">Next Question</button>
            <button id="back-to-menu-quiz" class="w-full mt-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-3 px-6 rounded-lg btn">Back to Menu</button>
        </div>

        <!-- Results Screen -->
        <div id="results-screen" class="hidden text-center bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-xl">
