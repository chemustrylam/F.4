            // Section 6: Copied from original, spelling adjusted
            { section: 6, type: 'mcq', question: 'The permanganate ion (MnO₄⁻) in aqueous solution is:', options: ['Yellow', 'Orange', 'Purple', 'Green'], answer: 'Purple' },
            { section: 6, type: 'mcq', question: 'The chromate ion (CrO₄²⁻) in aqueous solution is:', options: ['Orange', 'Yellow', 'Green', 'Blue'], answer: 'Yellow' },
            { section: 6, type: 'mcq', question: 'The dichromate ion (Cr₂O₇²⁻) in aqueous solution is:', options: ['Yellow', 'Purple', 'Orange', 'Colourless'], answer: 'Orange' },
            { section: 6, type: 'mcq', question: 'The ammonium ion (NH₄⁺) in aqueous solution is:', options: ['Green', 'Purple', 'Yellow', 'Colourless'], answer: 'Colourless' },
            { section: 6, type: 'mcq', question: 'The hydroxide ion (OH⁻) in aqueous solution is:', options: ['Blue', 'Orange', 'Colourless', 'Pink'], answer: 'Colourless' },
            { section: 6, type: 'mcq', question: 'The nitrate ion (NO₃⁻) in aqueous solution is:', options: ['Yellow', 'Colourless', 'Brown', 'Red'], answer: 'Colourless' },
            { section: 6, type: 'mcq', question: 'Which of the following polyatomic ions is typically colourless in aqueous solution?', options: ['CrO₄²⁻', 'MnO₄⁻', 'CO₃²⁻', 'Cr₂O₇²⁻'], answer: 'CO₃²⁻' },
            { section: 6, type: 'mcq', question: 'Which of the following polyatomic ions is purple in aqueous solution?', options: ['CrO₄²⁻', 'MnO₄⁻', 'NO₃⁻', 'OH⁻'], answer: 'MnO₄⁻' },
            { section: 6, type: 'mcq', question: 'The sulphate ion (SO₄²⁻) in aqueous solution is:', options: ['Blue', 'Yellow', 'Colourless', 'Green'], answer: 'Colourless' },
            { section: 6, type: 'mcq', question: 'The phosphate ion (PO₄³⁻) in aqueous solution is:', options: ['Green', 'Colourless', 'Orange', 'Purple'], answer: 'Colourless' }
        ];

        // --- DOM Elements ---
        const startScreen = document.getElementById('start-screen');
        const quizScreen = document.getElementById('quiz-screen');
        const resultsScreen = document.getElementById('results-screen');
        
        const restartBtn = document.getElementById('restart-btn');
        const nextBtn = document.getElementById('next-btn');
        const backToMenuQuizBtn = document.getElementById('back-to-menu-quiz');
        const backToMenuResultsBtn = document.getElementById('back-to-menu-results');

        const questionCounter = document.getElementById('question-counter');
        const scoreCounter = document.getElementById('score-counter');
        const progressBar = document.getElementById('progress-bar');
        const questionText = document.getElementById('question-text');
        const answerOptionsContainer = document.getElementById('answer-options');
        
        const finalScore = document.getElementById('final-score');
        const finalMessage = document.getElementById('final-message');

        // --- Quiz State ---
        let currentQuestionIndex = 0;
        let score = 0;
        let currentSection = 0;
        let sectionQuestions = [];

        // --- Functions ---
        function startQuiz(section) {
            currentSection = section;
            sectionQuestions = quizData.filter(q => q.section === section);
            currentQuestionIndex = 0;
            score = 0;
            
            startScreen.classList.add('hidden');
            resultsScreen.classList.add('hidden');
            quizScreen.classList.remove('hidden');
            nextBtn.classList.add('hidden');
            
            updateScore();
            showQuestion();
        }

        function showQuestion() {
            resetState();
            const currentQuestion = sectionQuestions[currentQuestionIndex];
            
            questionCounter.textContent = `Question ${currentQuestionIndex + 1} / ${sectionQuestions.length}`;
            progressBar.style.width = `${((currentQuestionIndex + 1) / sectionQuestions.length) * 100}%`;
            questionText.innerHTML = currentQuestion.question;

            currentQuestion.options.forEach(option => {
                const button = document.createElement('button');
                button.innerHTML = option;
                button.classList.add('block', 'w-full', 'text-left', 'p-4', 'rounded-lg', 'border-2', 'border-gray-300', 'dark:border-gray-600', 'bg-white', 'dark:bg-gray-800', 'hover:bg-gray-100', 'dark:hover:bg-gray-700', 'btn');
                button.addEventListener('click', () => selectAnswer(button, option));
                answerOptionsContainer.appendChild(button);
            });
        }

        function resetState() {
            feedback.textContent = '';
            nextBtn.classList.add('hidden');
            while (answerOptionsContainer.firstChild) {
                answerOptionsContainer.removeChild(answerOptionsContainer.firstChild);
            }
        }

        function selectAnswer(button, selectedOption) {
            const currentQuestion = sectionQuestions[currentQuestionIndex];
            const correct = selectedOption === currentQuestion.answer;
            
            if (correct) {
                score++;
                feedback.textContent = "Correct!";
                feedback.classList.add('text-green-500');
                feedback.classList.remove('text-red-500');
                button.classList.add('correct');
            } else {
                feedback.innerHTML = `Incorrect. The correct answer is: <br><strong>${currentQuestion.answer}</strong>`;
                feedback.classList.add('text-red-500');
                feedback.classList.remove('text-green-500');
                button.classList.add('incorrect');
                // Highlight correct answer
                Array.from(answerOptionsContainer.children).forEach(btn => {
                    if (btn.innerHTML === currentQuestion.answer) {
                        btn.classList.add('correct');
                    }
                });
            }

            Array.from(answerOptionsContainer.children).forEach(btn => {
                btn.disabled = true; // Disable all buttons
            });

            updateScore();
            nextBtn.classList.remove('hidden');
        }

        function updateScore() {
            scoreCounter.textContent = `Score: ${score}`;
        }
        
        function showNextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < sectionQuestions.length) {
                showQuestion();
            } else {
                showResults();
            }
        }

        function showResults() {
            quizScreen.classList.add('hidden');
            resultsScreen.classList.remove('hidden');
            
            const percentage = Math.round((score / sectionQuestions.length) * 100);
            finalScore.textContent = `${percentage}%`;
            
            let message = '';
            if (percentage === 100) {
                message = "Perfect score! You're a true Polyatomic Ion Master!";
            } else if (percentage >= 80) {
                message = "Excellent job! You have a strong command of this section.";
            } else if (percentage >= 60) {
                message = "Good effort! A little more practice and you'll be an expert.";
            } else {
                message = "Keep practicing! Repetition is key to memorizing these ions.";
            }
            finalMessage.textContent = message;
        }

        function showMenu() {
             quizScreen.classList.add('hidden');
             resultsScreen.classList.add('hidden');
             startScreen.classList.remove('hidden');
        }

        // --- Event Listeners ---
        restartBtn.addEventListener('click', () => startQuiz(currentSection));
        nextBtn.addEventListener('click', showNextQuestion);
        backToMenuQuizBtn.addEventListener('click', showMenu);
        backToMenuResultsBtn.addEventListener('click', showMenu);
    </script>
</body>
</html>



