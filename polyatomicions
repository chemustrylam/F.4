                 <button onclick="startQuiz(4)" class="bg-teal-600 hover:bg-teal-700 text-white font-bold py-4 px-6 rounded-lg text-lg btn">Section 4: Name from Formula</button>
                 <button onclick="startQuiz(5)" class="bg-teal-600 hover:bg-teal-700 text-white font-bold py-4 px-6 rounded-lg text-lg btn">Section 5: Formula from Name</button>
                 <button onclick="startQuiz(6)" class="bg-teal-600 hover:bg-teal-700 text-white font-bold py-4 px-6 rounded-lg text-lg btn">Section 6: State the Colour</button>
            </div>
        </div>

        <!-- Quiz Screen -->
        <div id="quiz-screen" class="hidden bg-white dark:bg-gray-800 p-6 sm:p-8 rounded-2xl shadow-xl">
            <div class="flex justify-between items-center mb-4">
                <div id="question-counter" class="text-sm font-semibold text-gray-500 dark:text-gray-400"></div>
